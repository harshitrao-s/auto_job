# ---------------------------------------------------------------------------
# Copy to .env and edit.  NEVER put your LinkedIn password here - the bot does
# not log in for you; it reuses a Chrome profile where you are already signed in.
# ---------------------------------------------------------------------------

# --- Search -----------------------------------------------------------------
KEYWORDS=Frontend Developer,React.js Developer,Next.js Developer,Full Stack Developer,JavaScript Developer,Node.js Developer,Software Engineer
LOCATIONS=Gurugram, Haryana, India|Delhi, India|India
REMOTE_ONLY=false
EXPERIENCE_MIN_YEARS=2
EXPERIENCE_MAX_YEARS=4
JOB_TYPES=F
EASY_APPLY_ONLY=true
SORT_BY=DD
DATE_POSTED=r86400
PAGES_PER_SEARCH=2

# --- Matching ---------------------------------------------------------------
MIN_MATCH_SCORE=60

# --- Automation controls ----------------------------------------------------
MAX_APPLICATIONS_PER_SESSION=10
MAX_JOBS_TO_PROCESS=60
AUTO_SUBMIT=false
HEADLESS=false
INTERACTIVE=true
MAX_CONSECUTIVE_FAILURES=3

# --- Pacing (seconds) -------------------------------------------------------
MIN_ACTION_DELAY=1.5
MAX_ACTION_DELAY=4.0
BETWEEN_JOBS_DELAY=8.0
BETWEEN_SEARCHES_DELAY=15.0

# --- Browser ----------------------------------------------------------------
# Leave CHROME_USER_DATA_DIR empty to use a dedicated profile under ./browser_profile
# To reuse your real Chrome session (Chrome must be fully closed first), e.g.:
# CHROME_USER_DATA_DIR=C:\Users\YOU\AppData\Local\Google\Chrome\User Data
CHROME_USER_DATA_DIR=
CHROME_PROFILE_DIRECTORY=Default
BROWSER_CHANNEL=chrome
SLOW_MO_MS=120
NAV_TIMEOUT_MS=45000

# --- Files ------------------------------------------------------------------
RESUME_PATH=resume/resume.pdf
PROFILE_PATH=config/profile.yaml
DB_PATH=data/applications.sqlite3
ANSWERS_PATH=data/answers.json
LOG_LEVEL=INFO
SCREENSHOT_ON_ERROR=true

# --- Platforms --------------------------------------------------------------
# linkedin, naukri, or both (comma separated)
PLATFORMS=linkedin,naukri

# Cookie JSON exported from YOUR OWN logged-in browser (Cookie-Editor
# "Export -> JSON"). Keep these files private - they are login sessions.
LINKEDIN_COOKIES_PATH=cookies/linkedin_cookies.json
NAUKRI_COOKIES_PATH=cookies/naukri_cookies.json

# --- Output -----------------------------------------------------------------
# CSVs are written to OUTPUT_DIR/<YYYY-MM-DD>/applications_<HHMMSS>.csv
OUTPUT_DIR=output
EXPORT_CSV=true
